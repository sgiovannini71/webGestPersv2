<%@ Page Title="Confronto TTOO/FEO" Language="C#" MasterPageFile="~/Site.Master" Inherits="WebGestPersV2.HomePage" %>
<%@ Import Namespace="System.Configuration" %><%@ Import Namespace="System.Data" %><%@ Import Namespace="System.Data.SqlClient" %><%@ Import Namespace="System.Text" %>
<script runat="server">
 private string Cs{get{return ConfigurationManager.ConnectionStrings["DipendentiDB"].ConnectionString;}} private int Livello{get{int n;return int.TryParse(Level.SelectedValue,out n)&&n>=1&&n<=3?n:1;}} private int? N(string x){int n;return int.TryParse(x,out n)?(int?)n:null;}
 protected override void OnLoad(EventArgs e){base.OnLoad(e);if(!IsPostBack){int l;if(int.TryParse(Request.QueryString["livello"],out l)&&Level.Items.FindByValue(l.ToString())!=null)Level.SelectedValue=l.ToString();CaricaU1();ImpostaDaQuery();Carica();}}
 private void ImpostaDaQuery(){int u1,u2;if(int.TryParse(Request.QueryString["u1"],out u1)){Sel(Office1,u1.ToString());CaricaU2();}if(int.TryParse(Request.QueryString["u2"],out u2)){Sel(Office2,u2.ToString());CaricaU3();}}
 protected void Level_Changed(object s,EventArgs e){if(Livello==1){Office2.ClearSelection();CaricaU3();}else if(Livello==2){Office3.ClearSelection();}Carica();} protected void Office1_Changed(object s,EventArgs e){CaricaU2();Carica();} protected void Office2_Changed(object s,EventArgs e){CaricaU3();if(!string.IsNullOrEmpty(Office2.SelectedValue))Level.SelectedValue="2";Carica();} protected void Filter_Changed(object s,EventArgs e){if(object.ReferenceEquals(s,Office3)&&!string.IsNullOrEmpty(Office3.SelectedValue))Level.SelectedValue="3";Carica();} protected void Export_Click(object s,EventArgs e){Esporta(Dati());}
 private void CaricaU1(){Bind(Office1,"SELECT ID_Uff1,RTRIM(SgUff1)+' - '+DescUff1 FROM dbo.Liv1Uff WHERE Attivo='S' AND ID_Uff1<>@v ORDER BY livello,SgUff1","Tutte le unità","@v",ConfigurationManager.AppSettings["UffLiv1_empty"]);Vuoto(Office2,"Tutti i 2° livelli");Vuoto(Office3,"Tutti i 3° livelli");}
 private void CaricaU2(){int id;if(!int.TryParse(Office1.SelectedValue,out id)){Vuoto(Office2,"Tutti i 2° livelli");Vuoto(Office3,"Tutti i 3° livelli");return;}Bind(Office2,"SELECT ID_Uff2,RTRIM(SgUff2)+' - '+DescUff2 FROM dbo.Liv2Uff WHERE ID_Uff1=@v ORDER BY livello,SgUff2","Tutti i 2° livelli","@v",id);Vuoto(Office3,"Tutti i 3° livelli");}
 private void CaricaU3(){int a,b;if(!int.TryParse(Office1.SelectedValue,out a)||!int.TryParse(Office2.SelectedValue,out b)){Vuoto(Office3,"Tutti i 3° livelli");return;}Office3.Items.Clear();Office3.Items.Add(new System.Web.UI.WebControls.ListItem("Tutti i 3° livelli",""));using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("SELECT ID_Uff3,RTRIM(SgUff3)+' - '+DescUff3 FROM dbo.Liv3Uff WHERE ID_Uff1=@a AND ID_Uff2=@b ORDER BY livello,SgUff3",c)){q.Parameters.Add("@a",SqlDbType.Int).Value=a;q.Parameters.Add("@b",SqlDbType.Int).Value=b;c.Open();using(var r=q.ExecuteReader())while(r.Read())Office3.Items.Add(new System.Web.UI.WebControls.ListItem(Convert.ToString(r[1]),Convert.ToString(r[0])));}}
 private void Carica(){try{ContextTitle.Text=Server.HtmlEncode(DescrizioneContesto());DataTable d=Dati();Items.DataSource=d;Items.DataBind();Count.Text=d.Rows.Count+" unità";long tt=Somma(d,"TTOO_Totale"),fe=Somma(d,"FEO_Totale"),sc=Somma(d,"Scopertura"),ec=Somma(d,"Eccedenza");KpiTtoo.Text=tt.ToString();KpiFeo.Text=fe.ToString();KpiGap.Text=(fe-tt).ToString();KpiShortage.Text=sc.ToString();KpiExcess.Text=ec.ToString();Message.Visible=false;}catch(Exception ex){Message.Text=Server.HtmlEncode(ex.Message);Message.Visible=true;}}
 private string DescrizioneContesto(){string livello=Livello==1?"primo livello":Livello==2?"secondo livello":"terzo livello";string unita="tutte le unità";if(Livello==1&&!string.IsNullOrEmpty(Office1.SelectedValue))unita=Office1.SelectedItem.Text;else if(Livello==2&&!string.IsNullOrEmpty(Office2.SelectedValue))unita=Office2.SelectedItem.Text;else if(Livello==3&&!string.IsNullOrEmpty(Office3.SelectedValue))unita=Office3.SelectedItem.Text;else if(Livello>1&&!string.IsNullOrEmpty(Office1.SelectedValue))unita="unità dipendenti da "+Office1.SelectedItem.Text;if(Livello==3&&!string.IsNullOrEmpty(Office2.SelectedValue)&&string.IsNullOrEmpty(Office3.SelectedValue))unita="unità dipendenti da "+Office2.SelectedItem.Text;return "Consistenza del "+livello+" — "+unita;}
 private DataTable Dati(){int l=Livello;string units=l==1?"SELECT ID_Uff1,CAST(NULL AS int) ID_Uff2,CAST(NULL AS int) ID_Uff3,RTRIM(SgUff1) Sigla,DescUff1 Descrizione,livello Ordine FROM dbo.Liv1Uff WHERE Attivo='S'":l==2?"SELECT ID_Uff1,ID_Uff2,CAST(NULL AS int) ID_Uff3,RTRIM(SgUff2) Sigla,DescUff2 Descrizione,livello Ordine FROM dbo.Liv2Uff":"SELECT ID_Uff1,ID_Uff2,ID_Uff3,RTRIM(SgUff3) Sigla,DescUff3 Descrizione,livello Ordine FROM dbo.Liv3Uff";string match=l==1?"p.ID_Uff1=u.ID_Uff1":l==2?"p.ID_Uff1=u.ID_Uff1 AND p.ID_Uff2=u.ID_Uff2":"p.ID_Uff1=u.ID_Uff1 AND p.ID_Uff2=u.ID_Uff2 AND p.ID_Uff3=u.ID_Uff3";string mi=l==1?"i.ID_Uff1=u.ID_Uff1":l==2?"i.ID_Uff1=u.ID_Uff1 AND i.ID_Uff2=u.ID_Uff2":"i.ID_Uff1=u.ID_Uff1 AND i.ID_Uff2=u.ID_Uff2 AND i.ID_Uff3=u.ID_Uff3";string sql=@"WITH U AS("+units+@"),D AS(SELECT u.ID_Uff1,u.ID_Uff2,u.ID_Uff3,u.Sigla,u.Descrizione,ISNULL(t.M,0) TTOO_Militari,ISNULL(t.C,0) TTOO_Civili,ISNULL(f.M,0) FEO_Militari,ISNULL(f.C,0) FEO_Civili FROM U u OUTER APPLY(SELECT SUM(CASE WHEN p.TipoPersonale='M' THEN p.NumeroPrevisto ELSE 0 END) M,SUM(CASE WHEN p.TipoPersonale='C' THEN p.NumeroPrevisto ELSE 0 END) C FROM dbo.TTOO_Posizioni p WHERE p.Attivo='S' AND "+match+@")t OUTER APPLY(SELECT COUNT(DISTINCT CASE WHEN ep.Militare=1 THEN ep.IDPersonale END) M,COUNT(DISTINCT CASE WHEN ep.Militare=0 THEN ep.IDPersonale END) C FROM dbo.Incarichi i INNER JOIN dbo.ElencoPersonale ep ON ep.IDPersonale=i.IDPersonale WHERE i.principale=1 AND i.id_tipo_incarico<>-1 AND ep.Stato_Servizio='attivo' AND "+mi+@")f WHERE (@u1 IS NULL OR u.ID_Uff1=@u1) AND (@u2 IS NULL OR u.ID_Uff2=@u2) AND (@u3 IS NULL OR u.ID_Uff3=@u3)),C AS(SELECT *,CASE @tipo WHEN 'M' THEN TTOO_Militari WHEN 'C' THEN TTOO_Civili ELSE TTOO_Militari+TTOO_Civili END TTOO_Totale,CASE @tipo WHEN 'M' THEN FEO_Militari WHEN 'C' THEN FEO_Civili ELSE FEO_Militari+FEO_Civili END FEO_Totale FROM D),R AS(SELECT *,FEO_Totale-TTOO_Totale Differenza,CASE WHEN FEO_Totale<TTOO_Totale THEN TTOO_Totale-FEO_Totale ELSE 0 END Scopertura,CASE WHEN FEO_Totale>TTOO_Totale THEN FEO_Totale-TTOO_Totale ELSE 0 END Eccedenza,CAST(CASE WHEN TTOO_Totale=0 THEN NULL ELSE FEO_Totale*100.0/TTOO_Totale END AS decimal(7,2)) PercentualeCopertura,CASE WHEN TTOO_Totale=0 AND FEO_Totale>0 THEN 'PERSONALE NON PREVISTO' WHEN TTOO_Totale>0 AND FEO_Totale=0 THEN 'SCOPERTA' WHEN FEO_Totale<TTOO_Totale THEN 'PARZIALMENTE COPERTA' WHEN FEO_Totale=TTOO_Totale AND TTOO_Totale>0 THEN 'COPERTA' WHEN FEO_Totale>TTOO_Totale THEN 'ECCEDENZA' ELSE 'NESSUN DATO' END StatoCopertura FROM C) SELECT ID_Uff1,ID_Uff2,ID_Uff3,Sigla+' - '+Descrizione AS Unita,TTOO_Militari,TTOO_Civili,TTOO_Totale,FEO_Militari,FEO_Civili,FEO_Totale,Differenza,Scopertura,Eccedenza,PercentualeCopertura,StatoCopertura FROM R WHERE (@stato='' OR StatoCopertura=@stato) ORDER BY Sigla,Descrizione";var dt=new DataTable();using(var c=new SqlConnection(Cs))using(var q=new SqlCommand(sql,c)){q.Parameters.Add("@u1",SqlDbType.Int).Value=(object)N(Office1.SelectedValue)??DBNull.Value;q.Parameters.Add("@u2",SqlDbType.Int).Value=(object)N(Office2.SelectedValue)??DBNull.Value;q.Parameters.Add("@u3",SqlDbType.Int).Value=(object)N(Office3.SelectedValue)??DBNull.Value;q.Parameters.Add("@tipo",SqlDbType.Char,1).Value=Type.SelectedValue;q.Parameters.Add("@stato",SqlDbType.VarChar,50).Value=Coverage.SelectedValue;c.Open();using(var a=new SqlDataAdapter(q))a.Fill(dt);}dt.Columns.Add("NextUrl",typeof(string));foreach(DataRow r in dt.Rows){if(l==1)r["NextUrl"]="TtooConsistenza.aspx?livello=2&u1="+r["ID_Uff1"];else if(l==2)r["NextUrl"]="TtooConsistenza.aspx?livello=3&u1="+r["ID_Uff1"]+"&u2="+r["ID_Uff2"];else r["NextUrl"]="";}return dt;}
 private static long Somma(DataTable d,string c){long n=0;foreach(DataRow r in d.Rows)if(r[c]!=DBNull.Value)n+=Convert.ToInt64(r[c]);return n;} protected bool HaDettaglio(object x){return !string.IsNullOrWhiteSpace(Convert.ToString(x));}
 private void Esporta(DataTable d){var s=new StringBuilder();foreach(DataColumn c in d.Columns)if(c.ColumnName!="NextUrl")s.Append(Csv(c.ColumnName)).Append(';');s.AppendLine();foreach(DataRow r in d.Rows){foreach(DataColumn c in d.Columns)if(c.ColumnName!="NextUrl")s.Append(Csv(Convert.ToString(r[c]))).Append(';');s.AppendLine();}Response.Clear();Response.ContentType="text/csv";Response.ContentEncoding=Encoding.UTF8;Response.AddHeader("Content-Disposition","attachment; filename=TTOO_FEO_livello_"+Livello+".csv");Response.BinaryWrite(Encoding.UTF8.GetPreamble());Response.Write(s.ToString());Response.End();}private static string Csv(string x){return "\""+(x??"").Replace("\"","\"\"")+"\"";}
 private void Bind(System.Web.UI.WebControls.DropDownList d,string sql,string first,string pn,object pv){d.Items.Clear();d.Items.Add(new System.Web.UI.WebControls.ListItem(first,""));using(var c=new SqlConnection(Cs))using(var q=new SqlCommand(sql,c)){q.Parameters.Add(pn,SqlDbType.Int).Value=Convert.ToInt32(pv);c.Open();using(var r=q.ExecuteReader())while(r.Read())d.Items.Add(new System.Web.UI.WebControls.ListItem(Convert.ToString(r[1]),Convert.ToString(r[0])));}}private static void Vuoto(System.Web.UI.WebControls.DropDownList d,string t){d.Items.Clear();d.Items.Add(new System.Web.UI.WebControls.ListItem(t,""));}private static void Sel(System.Web.UI.WebControls.ListControl d,string v){var x=d.Items.FindByValue(v);if(x!=null){d.ClearSelection();x.Selected=true;}}
</script>
<asp:Content ID="Title" ContentPlaceHolderID="TitleContent" runat="server">Confronto TTOO/FEO</asp:Content>
<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
 <a class="back-link" href="Ttoo.aspx">← Gestione TTOO</a><div class="page-heading"><p class="eyebrow">TTOO / FEO</p><h1>Consistenza per unità organizzativa</h1><p>Confronto tra organico teoricamente previsto e personale attivo effettivamente assegnato con incarico principale.</p></div><nav class="section-nav"><a href="#lettura">Guida alla lettura</a><a href="#kpi">Riepilogo</a><a href="#filtri">Filtri</a><a href="#risultati">Risultati</a><a href="TtooConsistenza.aspx?livello=1">1° livello</a><a href="TtooConsistenza.aspx?livello=2">2° livello</a><a href="TtooConsistenza.aspx?livello=3">3° livello</a><a href="TtooPosizioni.aspx">Posizioni TTOO</a></nav><asp:Label ID="Message" runat="server" CssClass="message error" Visible="false" /><div class="ttoo-context" aria-live="polite"><span>Visualizzazione corrente</span><strong><asp:Literal ID="ContextTitle" runat="server" /></strong></div>
 <section id="lettura" class="card detail-section anchor-section"><h2>Come leggere il confronto</h2><p><strong>TTOO</strong> indica le risorse previste; <strong>FEO</strong> il personale attivo effettivamente assegnato. La differenza è calcolata come FEO meno TTOO: un valore negativo segnala una carenza, un valore positivo un’eccedenza. La percentuale di copertura misura quanta parte dell’organico previsto risulta coperta.</p><h3>Cosa è possibile analizzare</h3><p>È possibile confrontare militari, civili o il totale, filtrare le unità per stato di copertura e passare progressivamente dal primo al terzo livello. I riepiloghi mostrano l’andamento complessivo dei risultati filtrati; il dettaglio consente di individuare scoperture, coperture complete, eccedenze e personale presente in unità prive di una corrispondente previsione TTOO.</p></section>
 <section id="kpi" class="ttoo-kpi-grid anchor-section"><div class="card"><span>TTOO</span><strong><asp:Literal ID="KpiTtoo" runat="server"/></strong></div><div class="card"><span>FEO</span><strong><asp:Literal ID="KpiFeo" runat="server"/></strong></div><div class="card"><span>Differenza</span><strong><asp:Literal ID="KpiGap" runat="server"/></strong></div><div class="card"><span>Scoperture</span><strong><asp:Literal ID="KpiShortage" runat="server"/></strong></div><div class="card"><span>Eccedenze</span><strong><asp:Literal ID="KpiExcess" runat="server"/></strong></div></section>
 <section id="filtri" class="card report-filters anchor-section"><div><label>Livello</label><asp:DropDownList ID="Level" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Level_Changed"><asp:ListItem Value="1">Primo livello</asp:ListItem><asp:ListItem Value="2">Secondo livello</asp:ListItem><asp:ListItem Value="3">Terzo livello</asp:ListItem></asp:DropDownList></div><div><label>Ufficio 1° livello</label><asp:DropDownList ID="Office1" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Office1_Changed"/></div><div><label>Ufficio 2° livello</label><asp:DropDownList ID="Office2" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Office2_Changed"/></div><div><label>Ufficio 3° livello</label><asp:DropDownList ID="Office3" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"/></div><div><label>Tipo</label><asp:DropDownList ID="Type" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"><asp:ListItem Value="">Tutto</asp:ListItem><asp:ListItem Value="M">Militare</asp:ListItem><asp:ListItem Value="C">Civile</asp:ListItem></asp:DropDownList></div><div><label>Copertura</label><asp:DropDownList ID="Coverage" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"><asp:ListItem Value="">Tutti gli stati</asp:ListItem><asp:ListItem>COPERTA</asp:ListItem><asp:ListItem>PARZIALMENTE COPERTA</asp:ListItem><asp:ListItem>SCOPERTA</asp:ListItem><asp:ListItem>ECCEDENZA</asp:ListItem><asp:ListItem>PERSONALE NON PREVISTO</asp:ListItem><asp:ListItem>NESSUN DATO</asp:ListItem></asp:DropDownList></div></section>
 <section id="risultati" class="card report-wide anchor-section"><div class="report-section-title"><asp:Label ID="Count" runat="server" CssClass="result-count"/><asp:Button runat="server" Text="Esporta CSV" CssClass="button secondary" OnClick="Export_Click"/></div><asp:GridView ID="Items" runat="server" AutoGenerateColumns="false" CssClass="data-grid"><Columns><asp:BoundField DataField="Unita" HeaderText="Unità organizzativa"/><asp:BoundField DataField="TTOO_Militari" HeaderText="TTOO M"/><asp:BoundField DataField="TTOO_Civili" HeaderText="TTOO C"/><asp:BoundField DataField="TTOO_Totale" HeaderText="TTOO"/><asp:BoundField DataField="FEO_Militari" HeaderText="FEO M"/><asp:BoundField DataField="FEO_Civili" HeaderText="FEO C"/><asp:BoundField DataField="FEO_Totale" HeaderText="FEO"/><asp:BoundField DataField="Differenza" HeaderText="Differenza"/><asp:BoundField DataField="Scopertura" HeaderText="Scopertura"/><asp:BoundField DataField="Eccedenza" HeaderText="Eccedenza"/><asp:BoundField DataField="PercentualeCopertura" HeaderText="Copertura %"/><asp:BoundField DataField="StatoCopertura" HeaderText="Stato"/><asp:TemplateField HeaderText=""><ItemTemplate><asp:HyperLink runat="server" Text="Approfondisci" NavigateUrl='<%# Eval("NextUrl") %>' Visible='<%# HaDettaglio(Eval("NextUrl")) %>' /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section>
</asp:Content>
