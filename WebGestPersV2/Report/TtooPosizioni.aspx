<%@ Page Title="Posizioni TTOO" Language="C#" MasterPageFile="~/Site.Master" Inherits="WebGestPersV2.HomePage" MaintainScrollPositionOnPostback="true" %>
<%@ Import Namespace="System.Configuration" %><%@ Import Namespace="System.Data" %><%@ Import Namespace="System.Data.SqlClient" %><%@ Import Namespace="System.Collections.Generic" %>
<script runat="server">
 private string Cs{get{return ConfigurationManager.ConnectionStrings["DipendentiDB"].ConnectionString;}} protected bool PuoModificare(){int l=UtenteCorrente.Livello;return l==150||l==160||l==170||l==200;} private int? N(string s){int n;return int.TryParse(s,out n)?(int?)n:null;}
 protected override void OnLoad(EventArgs e){base.OnLoad(e);EditPanel.Visible=PuoModificare()&&!string.IsNullOrEmpty(Request.QueryString["edit"]);NewLink.Visible=PuoModificare();if(!IsPostBack){CaricaListe();CaricaFiltriDipendenti();if(EditPanel.Visible)CaricaForm();CaricaGrid();}}
 private void CaricaListe(){Bind(FOffice1,"SELECT ID_Uff1,RTRIM(SgUff1)+' - '+DescUff1 FROM dbo.Liv1Uff WHERE Attivo='S' AND ID_Uff1<>@vuoto ORDER BY livello,SgUff1","-- seleziona --","@vuoto",ConfigurationManager.AppSettings["UffLiv1_empty"]);Bind(FilterOffice1,"SELECT ID_Uff1,RTRIM(SgUff1)+' - '+DescUff1 FROM dbo.Liv1Uff WHERE Attivo='S' AND ID_Uff1<>@vuoto ORDER BY livello,SgUff1","Tutti gli uffici","@vuoto",ConfigurationManager.AppSettings["UffLiv1_empty"]);Bind(AssignmentType,"SELECT id_tipo_incarico,RTRIM(Sigla_incarico)+' - '+ISNULL(Descr_incarico,'') FROM dbo.Tipo_incarichi WHERE id_tipo_incarico<>-1 ORDER BY livello,Descr_incarico","-- seleziona --",null,null);Bind(MilitaryCategory,"SELECT ID_CategoriaMilitare,Sigla+' - '+Descrizione FROM dbo.TTOO_CategorieMilitari WHERE Attivo='S' ORDER BY Ordine,Sigla","-- seleziona --",null,null);Bind(CivilTitle,"SELECT ID_Titolo,RTRIM(Sigla_titolo)+' - '+ISNULL(Descr,'') FROM dbo.Titoli ORDER BY livello,Sigla_titolo","-- seleziona --",null,null);Forces.Items.Clear();using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("SELECT ID_Arma,RTRIM(SiglaArma)+' - '+ISNULL(DescArma,'') FROM dbo.FFAA WHERE ID_Arma IN(1,2,3,4) ORDER BY ID_Arma",c)){c.Open();using(var r=q.ExecuteReader())while(r.Read())Forces.Items.Add(new System.Web.UI.WebControls.ListItem(Convert.ToString(r.GetValue(1)),Convert.ToString(r.GetValue(0))));}BindVuoto(FOffice2,"-- nessuno --");BindVuoto(FOffice3,"-- nessuno --");}
 private void CaricaFiltriDipendenti(){BindVuoto(FilterOffice2,"Tutti i 2° livelli");BindVuoto(FilterOffice3,"Tutti i 3° livelli");}
 protected void FilterOffice1_Changed(object s,EventArgs e){BindFigli(FilterOffice2,1,FilterOffice1.SelectedValue,"Tutti i 2° livelli");BindVuoto(FilterOffice3,"Tutti i 3° livelli");CaricaGrid();} protected void FilterOffice2_Changed(object s,EventArgs e){BindTerzi(FilterOffice3,FilterOffice1.SelectedValue,FilterOffice2.SelectedValue,"Tutti i 3° livelli");CaricaGrid();} protected void Filter_Changed(object s,EventArgs e){CaricaGrid();}
 protected void FOffice1_Changed(object s,EventArgs e){BindFigli(FOffice2,1,FOffice1.SelectedValue,"-- nessuno --");BindVuoto(FOffice3,"-- nessuno --");} protected void FOffice2_Changed(object s,EventArgs e){BindTerzi(FOffice3,FOffice1.SelectedValue,FOffice2.SelectedValue,"-- nessuno --");} protected void PersonnelType_Changed(object s,EventArgs e){ConfiguraTipo();}
 private void CaricaGrid(){var dt=new DataTable();using(var c=new SqlConnection(Cs))using(var q=new SqlCommand(@"SELECT p.IDPosizioneTTOO,l1.SgUff1 AS Uff1,l2.SgUff2 AS Uff2,l3.SgUff3 AS Uff3,ti.Descr_incarico AS Incarico,CASE p.TipoPersonale WHEN 'M' THEN 'Militare' ELSE 'Civile' END AS Tipo,cm.Sigla AS Categoria,tt.Sigla_titolo AS Profilo,p.NumeroPrevisto,CASE p.Attivo WHEN 'S' THEN 'Attiva' ELSE 'Disattivata' END AS Stato,p.Note FROM dbo.TTOO_Posizioni p INNER JOIN dbo.Liv1Uff l1 ON l1.ID_Uff1=p.ID_Uff1 LEFT JOIN dbo.Liv2Uff l2 ON l2.ID_Uff1=p.ID_Uff1 AND l2.ID_Uff2=p.ID_Uff2 LEFT JOIN dbo.Liv3Uff l3 ON l3.ID_Uff1=p.ID_Uff1 AND l3.ID_Uff2=p.ID_Uff2 AND l3.ID_Uff3=p.ID_Uff3 INNER JOIN dbo.Tipo_incarichi ti ON ti.id_tipo_incarico=p.id_tipo_incarico LEFT JOIN dbo.TTOO_CategorieMilitari cm ON cm.ID_CategoriaMilitare=p.ID_CategoriaMilitare LEFT JOIN dbo.Titoli tt ON tt.ID_Titolo=p.ID_Titolo_Previsto WHERE (@u1 IS NULL OR p.ID_Uff1=@u1) AND (@u2 IS NULL OR p.ID_Uff2=@u2) AND (@u3 IS NULL OR p.ID_Uff3=@u3) AND (@tipo='' OR p.TipoPersonale=@tipo) AND (@stato='' OR p.Attivo=@stato) ORDER BY l1.livello,l2.livello,l3.livello,ti.livello",c)){q.Parameters.Add("@u1",SqlDbType.Int).Value=(object)N(FilterOffice1.SelectedValue)??DBNull.Value;q.Parameters.Add("@u2",SqlDbType.Int).Value=(object)N(FilterOffice2.SelectedValue)??DBNull.Value;q.Parameters.Add("@u3",SqlDbType.Int).Value=(object)N(FilterOffice3.SelectedValue)??DBNull.Value;q.Parameters.Add("@tipo",SqlDbType.Char,1).Value=FilterType.SelectedValue;q.Parameters.Add("@stato",SqlDbType.Char,1).Value=FilterStatus.SelectedValue;c.Open();using(var a=new SqlDataAdapter(q))a.Fill(dt);}Items.DataSource=dt;Items.DataBind();Count.Text=dt.Rows.Count+" posizioni";}
 private void CaricaForm(){string e=Request.QueryString["edit"];FormTitle.Text=e=="new"?"Nuova posizione TTOO":"Modifica posizione TTOO";if(e=="new"){Expected.Text="1";ConfiguraTipo();return;}int id;if(!int.TryParse(e,out id))throw new InvalidOperationException("Posizione non valida.");using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("SELECT ID_Uff1,ID_Uff2,ID_Uff3,id_tipo_incarico,TipoPersonale,ID_CategoriaMilitare,ID_Titolo_Previsto,NumeroPrevisto,Note FROM dbo.TTOO_Posizioni WHERE IDPosizioneTTOO=@id",c)){q.Parameters.Add("@id",SqlDbType.Int).Value=id;c.Open();using(var r=q.ExecuteReader()){if(!r.Read())throw new InvalidOperationException("Posizione non trovata.");OriginalId.Value=id.ToString();Sel(FOffice1,r[0]);BindFigli(FOffice2,1,FOffice1.SelectedValue,"-- nessuno --");Sel(FOffice2,r[1]);BindTerzi(FOffice3,FOffice1.SelectedValue,FOffice2.SelectedValue,"-- nessuno --");Sel(FOffice3,r[2]);Sel(AssignmentType,r[3]);Sel(PersonnelType,r[4]);Sel(MilitaryCategory,r[5]);Sel(CivilTitle,r[6]);Expected.Text=Convert.ToString(r[7]);Notes.Text=r.IsDBNull(8)?"":Convert.ToString(r[8]);}}ConfiguraTipo();CaricaForze(id);}
 private void ConfiguraTipo(){MilitaryFields.Visible=PersonnelType.SelectedValue=="M";CivilFields.Visible=PersonnelType.SelectedValue=="C";}
 private void CaricaForze(int id){using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("SELECT id_arma FROM dbo.TTOO_Posizioni_FFAA WHERE IDPosizioneTTOO=@id",c)){q.Parameters.Add("@id",SqlDbType.Int).Value=id;c.Open();using(var r=q.ExecuteReader())while(r.Read()){var x=Forces.Items.FindByValue(Convert.ToString(r[0]));if(x!=null)x.Selected=true;}}}
 protected void Save_Click(object s,EventArgs e){try{if(!PuoModificare())throw new InvalidOperationException("Operazione non autorizzata.");int u1,tipo,num;if(!int.TryParse(FOffice1.SelectedValue,out u1)||!int.TryParse(AssignmentType.SelectedValue,out tipo)||!int.TryParse(Expected.Text,out num)||num<=0)throw new InvalidOperationException("Compilare ufficio, incarico e numero previsto maggiore di zero.");int? u2=N(FOffice2.SelectedValue),u3=N(FOffice3.SelectedValue);if(u3.HasValue&&!u2.HasValue)throw new InvalidOperationException("Per selezionare il terzo livello occorre indicare il secondo livello.");VerificaGerarchia(u1,u2,u3);string tp=PersonnelType.SelectedValue;if(tp!="M"&&tp!="C")throw new InvalidOperationException("Selezionare il tipo di personale.");int cat=0,tit=0;if(tp=="M"&&!int.TryParse(MilitaryCategory.SelectedValue,out cat))throw new InvalidOperationException("Selezionare la categoria militare.");if(tp=="C"&&!int.TryParse(CivilTitle.SelectedValue,out tit))throw new InvalidOperationException("Selezionare il profilo civile.");var armi=new List<int>();foreach(System.Web.UI.WebControls.ListItem x in Forces.Items)if(x.Selected)armi.Add(Convert.ToInt32(x.Value));if(tp=="M"&&armi.Count==0)throw new InvalidOperationException("Selezionare almeno una Forza Armata.");Salva(N(OriginalId.Value),u1,u2,u3,tipo,tp,tp=="M"?(int?)cat:null,tp=="C"?(int?)tit:null,num,Notes.Text,armi);Response.Redirect("TtooPosizioni.aspx",false);Context.ApplicationInstance.CompleteRequest();}catch(Exception ex){Message.Text=Server.HtmlEncode(ex.Message);Message.Visible=true;}}
 private void VerificaGerarchia(int u1,int? u2,int? u3){using(var c=new SqlConnection(Cs)){c.Open();if(u2.HasValue)using(var q=new SqlCommand("SELECT COUNT(*) FROM dbo.Liv2Uff WHERE ID_Uff1=@u1 AND ID_Uff2=@u2",c)){q.Parameters.Add("@u1",SqlDbType.Int).Value=u1;q.Parameters.Add("@u2",SqlDbType.Int).Value=u2.Value;if(Convert.ToInt32(q.ExecuteScalar())!=1)throw new InvalidOperationException("L'ufficio di secondo livello non appartiene al primo livello selezionato.");}if(u3.HasValue)using(var q=new SqlCommand("SELECT COUNT(*) FROM dbo.Liv3Uff WHERE ID_Uff1=@u1 AND ID_Uff2=@u2 AND ID_Uff3=@u3",c)){q.Parameters.Add("@u1",SqlDbType.Int).Value=u1;q.Parameters.Add("@u2",SqlDbType.Int).Value=u2.Value;q.Parameters.Add("@u3",SqlDbType.Int).Value=u3.Value;if(Convert.ToInt32(q.ExecuteScalar())!=1)throw new InvalidOperationException("L'ufficio di terzo livello non appartiene ai livelli selezionati.");}}}
 private void Salva(int? id,int u1,int? u2,int? u3,int inc,string tp,int? cat,int? tit,int num,string note,List<int> armi){using(var c=new SqlConnection(Cs)){c.Open();using(var tx=c.BeginTransaction()){try{using(var q=new SqlCommand(id.HasValue?"UPDATE dbo.TTOO_Posizioni SET ID_Uff1=@u1,ID_Uff2=@u2,ID_Uff3=@u3,id_tipo_incarico=@inc,TipoPersonale=@tp,ID_CategoriaMilitare=@cat,ID_Titolo_Previsto=@tit,NumeroPrevisto=@num,Note=@note WHERE IDPosizioneTTOO=@id":"INSERT dbo.TTOO_Posizioni(ID_Uff1,ID_Uff2,ID_Uff3,id_tipo_incarico,TipoPersonale,ID_CategoriaMilitare,ID_Titolo_Previsto,NumeroPrevisto,Attivo,Note) VALUES(@u1,@u2,@u3,@inc,@tp,@cat,@tit,@num,'S',@note);SELECT CAST(SCOPE_IDENTITY() AS int)",c,tx)){q.Parameters.Add("@u1",SqlDbType.Int).Value=u1;q.Parameters.Add("@u2",SqlDbType.Int).Value=(object)u2??DBNull.Value;q.Parameters.Add("@u3",SqlDbType.Int).Value=(object)u3??DBNull.Value;q.Parameters.Add("@inc",SqlDbType.Int).Value=inc;q.Parameters.Add("@tp",SqlDbType.Char,1).Value=tp;q.Parameters.Add("@cat",SqlDbType.Int).Value=(object)cat??DBNull.Value;q.Parameters.Add("@tit",SqlDbType.Int).Value=(object)tit??DBNull.Value;q.Parameters.Add("@num",SqlDbType.Int).Value=num;q.Parameters.Add("@note",SqlDbType.VarChar,255).Value=string.IsNullOrWhiteSpace(note)?(object)DBNull.Value:note.Trim();if(id.HasValue){q.Parameters.Add("@id",SqlDbType.Int).Value=id.Value;if(q.ExecuteNonQuery()!=1)throw new InvalidOperationException("Posizione non trovata.");}else id=Convert.ToInt32(q.ExecuteScalar());}using(var q=new SqlCommand("DELETE dbo.TTOO_Posizioni_FFAA WHERE IDPosizioneTTOO=@id",c,tx)){q.Parameters.Add("@id",SqlDbType.Int).Value=id.Value;q.ExecuteNonQuery();}foreach(int a in armi)using(var q=new SqlCommand("INSERT dbo.TTOO_Posizioni_FFAA(IDPosizioneTTOO,id_arma) VALUES(@id,@a)",c,tx)){q.Parameters.Add("@id",SqlDbType.Int).Value=id.Value;q.Parameters.Add("@a",SqlDbType.Int).Value=a;q.ExecuteNonQuery();}tx.Commit();}catch{tx.Rollback();throw;}}}}
 protected void Disable_Click(object s,EventArgs e){try{if(!PuoModificare())throw new InvalidOperationException("Operazione non autorizzata.");int id;var b=(System.Web.UI.WebControls.LinkButton)s;if(!int.TryParse(b.CommandArgument,out id))throw new InvalidOperationException("Posizione non valida.");using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("UPDATE dbo.TTOO_Posizioni SET Attivo='N' WHERE IDPosizioneTTOO=@id",c)){q.Parameters.Add("@id",SqlDbType.Int).Value=id;c.Open();q.ExecuteNonQuery();}CaricaGrid();}catch(Exception ex){Message.Text=Server.HtmlEncode(ex.Message);Message.Visible=true;}}
 private void Bind(System.Web.UI.WebControls.DropDownList d,string sql,string first,string pn,object pv){d.Items.Clear();d.Items.Add(new System.Web.UI.WebControls.ListItem(first,""));using(var c=new SqlConnection(Cs))using(var q=new SqlCommand(sql,c)){if(pn!=null)q.Parameters.Add(pn,SqlDbType.Int).Value=Convert.ToInt32(pv);c.Open();using(var r=q.ExecuteReader())while(r.Read())d.Items.Add(new System.Web.UI.WebControls.ListItem(Convert.ToString(r[1]),Convert.ToString(r[0])));}} private void BindVuoto(System.Web.UI.WebControls.DropDownList d,string t){d.Items.Clear();d.Items.Add(new System.Web.UI.WebControls.ListItem(t,""));} private void BindFigli(System.Web.UI.WebControls.DropDownList d,int x,string p,string t){int id;if(!int.TryParse(p,out id)){BindVuoto(d,t);return;}Bind(d,"SELECT ID_Uff2,RTRIM(SgUff2)+' - '+DescUff2 FROM dbo.Liv2Uff WHERE ID_Uff1=@id ORDER BY livello,SgUff2",t,"@id",id);} private void BindTerzi(System.Web.UI.WebControls.DropDownList d,string p1,string p2,string t){int a,b;if(!int.TryParse(p1,out a)||!int.TryParse(p2,out b)){BindVuoto(d,t);return;}d.Items.Clear();d.Items.Add(new System.Web.UI.WebControls.ListItem(t,""));using(var c=new SqlConnection(Cs))using(var q=new SqlCommand("SELECT ID_Uff3,RTRIM(SgUff3)+' - '+DescUff3 FROM dbo.Liv3Uff WHERE ID_Uff1=@a AND ID_Uff2=@b ORDER BY livello,SgUff3",c)){q.Parameters.Add("@a",SqlDbType.Int).Value=a;q.Parameters.Add("@b",SqlDbType.Int).Value=b;c.Open();using(var r=q.ExecuteReader())while(r.Read())d.Items.Add(new System.Web.UI.WebControls.ListItem(Convert.ToString(r[1]),Convert.ToString(r[0])));}} private static void Sel(System.Web.UI.WebControls.ListControl d,object v){if(v==DBNull.Value)return;var x=d.Items.FindByValue(Convert.ToString(v));if(x!=null){d.ClearSelection();x.Selected=true;}}
</script>
