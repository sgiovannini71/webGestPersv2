<asp:Content ID="Main" ContentPlaceHolderID="MainContent" runat="server">
 <a class="back-link" href="Ttoo.aspx">← Gestione TTOO</a><div class="page-heading"><p class="eyebrow">TTOO</p><h1>Posizioni previste</h1><p>Elenco delle risorse teoricamente previste dalla tabella organica, associate alla struttura e al profilo richiesto.</p></div><nav class="section-nav"><a href="#lettura">Guida alla lettura</a><a href="#filtri">Filtri</a><a href="#elenco">Elenco</a><a href="TtooPosizioni.aspx?edit=new">Nuova posizione</a><a href="TtooConsistenza.aspx">Confronto TTOO/FEO</a></nav><asp:Label ID="Message" runat="server" CssClass="message error" Visible="false" />
 <section id="lettura" class="card detail-section anchor-section"><h2>Cosa rappresenta</h2><p>Ogni riga rappresenta una posizione prevista, non una persona realmente assegnata. La posizione è identificata dall’unità organizzativa, anche fino al terzo livello, dal tipo di incarico e dal numero di risorse previste. Per i militari sono indicati categoria e Forze Armate ammesse; per i civili il profilo previsto.</p><h3>Cosa è possibile analizzare</h3><p>I filtri consentono di verificare la distribuzione delle posizioni per ufficio, tipo di personale e stato. È possibile individuare quali profili sono previsti in ogni articolazione, controllarne la quantità e consultare anche le posizioni disattivate. Gli utenti autorizzati possono inserire e modificare le posizioni oppure disattivarle conservandone la registrazione.</p></section>
 <asp:Panel ID="EditPanel" runat="server" CssClass="card form-card" Visible="false"><h2><asp:Literal ID="FormTitle" runat="server" /></h2><asp:HiddenField ID="OriginalId" runat="server"/><div class="edit-grid"><label>Ufficio 1° livello*</label><asp:DropDownList ID="FOffice1" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FOffice1_Changed"/><span></span><label>Ufficio 2° livello</label><asp:DropDownList ID="FOffice2" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FOffice2_Changed"/><span></span><label>Ufficio 3° livello</label><asp:DropDownList ID="FOffice3" runat="server"/><span></span><label>Tipo incarico*</label><asp:DropDownList ID="AssignmentType" runat="server"/><span></span><label>Tipo personale*</label><asp:DropDownList ID="PersonnelType" runat="server" AutoPostBack="true" OnSelectedIndexChanged="PersonnelType_Changed"><asp:ListItem Value="">-- seleziona --</asp:ListItem><asp:ListItem Value="M">Militare</asp:ListItem><asp:ListItem Value="C">Civile</asp:ListItem></asp:DropDownList><span></span><asp:Panel ID="MilitaryFields" runat="server"><label>Categoria militare*</label><asp:DropDownList ID="MilitaryCategory" runat="server"/><label>Forze armate*</label><asp:CheckBoxList ID="Forces" runat="server"/></asp:Panel><asp:Panel ID="CivilFields" runat="server"><label>Profilo civile*</label><asp:DropDownList ID="CivilTitle" runat="server"/></asp:Panel><label>Numero previsto*</label><asp:TextBox ID="Expected" runat="server"/><span></span><label>Note</label><asp:TextBox ID="Notes" runat="server" TextMode="MultiLine" Rows="3" MaxLength="255"/><span></span></div><div class="form-actions"><asp:Button runat="server" Text="Salva" CssClass="button" OnClick="Save_Click"/><a class="button secondary" href="TtooPosizioni.aspx">Annulla</a></div></asp:Panel>
 <section id="filtri" class="card report-filters anchor-section"><div><label>Ufficio 1° livello</label><asp:DropDownList ID="FilterOffice1" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FilterOffice1_Changed"/></div><div><label>Ufficio 2° livello</label><asp:DropDownList ID="FilterOffice2" runat="server" AutoPostBack="true" OnSelectedIndexChanged="FilterOffice2_Changed"/></div><div><label>Ufficio 3° livello</label><asp:DropDownList ID="FilterOffice3" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"/></div><div><label>Tipo personale</label><asp:DropDownList ID="FilterType" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"><asp:ListItem Value="">Tutto</asp:ListItem><asp:ListItem Value="M">Militare</asp:ListItem><asp:ListItem Value="C">Civile</asp:ListItem></asp:DropDownList></div><div><label>Stato</label><asp:DropDownList ID="FilterStatus" runat="server" AutoPostBack="true" OnSelectedIndexChanged="Filter_Changed"><asp:ListItem Value="S">Attive</asp:ListItem><asp:ListItem Value="N">Disattivate</asp:ListItem><asp:ListItem Value="">Tutte</asp:ListItem></asp:DropDownList></div></section>
 <asp:HyperLink ID="NewLink" runat="server" NavigateUrl="TtooPosizioni.aspx?edit=new" CssClass="button">Nuova posizione</asp:HyperLink><section id="elenco" class="card detail-section report-wide anchor-section"><asp:Label ID="Count" runat="server" CssClass="result-count"/><asp:GridView ID="Items" runat="server" AutoGenerateColumns="false" CssClass="data-grid"><Columns><asp:BoundField DataField="Uff1" HeaderText="Liv. 1"/><asp:BoundField DataField="Uff2" HeaderText="Liv. 2"/><asp:BoundField DataField="Uff3" HeaderText="Liv. 3"/><asp:BoundField DataField="Incarico" HeaderText="Incarico"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="Categoria" HeaderText="Categoria"/><asp:BoundField DataField="Profilo" HeaderText="Profilo civile"/><asp:BoundField DataField="NumeroPrevisto" HeaderText="Previsti"/><asp:BoundField DataField="Stato" HeaderText="Stato"/><asp:BoundField DataField="Note" HeaderText="Note"/><asp:TemplateField HeaderText="Azioni"><ItemTemplate><a href='<%# "TtooPosizioni.aspx?edit="+Eval("IDPosizioneTTOO") %>'>Modifica</a> <asp:LinkButton runat="server" Text="Disattiva" CommandArgument='<%# Eval("IDPosizioneTTOO") %>' OnClick="Disable_Click" OnClientClick="return confirm('Disattivare questa posizione TTOO?');" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section>
</asp:Content>
