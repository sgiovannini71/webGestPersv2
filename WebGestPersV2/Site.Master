<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebGestPersV2.SiteMaster" %>
<!DOCTYPE html>
<html lang="it">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /> - WebGestPers v2</title>
    <link href="<%= ResolveUrl("~/Content/site.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/help.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/report.css") %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="MainForm" runat="server">
    <header class="site-header">
        <a class="brand" href="<%= ResolveUrl("~/Default.aspx") %>"><img class="brand-logo" src="<%= ResolveUrl("~/img/nuovo_logo_armaereo.png") %>" alt="Logo Arma Aeronautica" /><span class="brand-name">WebGestPers <span>v2</span></span></a>
        <nav><a href="<%= ResolveUrl("~/Personale/Elenco.aspx") %>">Personale</a> <a href="<%= ResolveUrl("~/Personale/Nuovo.aspx") %>">Nuovo inserimento</a> <a href="<%= ResolveUrl("~/Gestione/Indice.aspx") %>">Tabelle di gestione</a> <a href="<%= ResolveUrl("~/Report/Indice.aspx") %>">Report</a> <a href="<%= ResolveUrl("~/Help/Default.aspx") %>">Help</a></nav>
        <div class="current-user"><asp:LoginName ID="CurrentUser" runat="server" /></div>
    </header>
    <main class="page"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main>
    <footer>Gestione del personale · ASP.NET Web Forms</footer>
</form>
</body>
</html>
